#!/bin/bash

#module load gcc/16.0.0
module load gcc/13.2.0

#module load llvm/15.0.7
#export CC=clang

export MYCUDA=13.0.0
export PAPI_CUDA_ROOT=/packages/cuda/$MYCUDA
export LD_LIBRARY_PATH=/packages/cuda/$MYCUDA/lib64:/packages/cuda/$MYCUDA/extras/CUPTI/lib64:/packages/cuda/$MYCUDA/nsight-compute-2026.1.1/target/linux-desktop-glibc_2_11_3-x64:/packages/cuda/$MYCUDA/nsight-systems-2025.6.3/target-linux-x64:${LD_LIBRARY_PATH}
export PATH=/packages/cuda/$MYCUDA/bin:${PATH}


## Main variables.
export PAPI=/home/users/dbarry/apps/papi-strav
export PAPI_DIR=${PAPI}
export LD_LIBRARY_PATH=${PAPI_DIR}/lib:${LD_LIBRARY_PATH}
export PATH=${PAPI_DIR}/bin:${PATH}
