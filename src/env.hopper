#!/bin/bash

module use e4s
source /packages/e4s/23.11/mvapich/spack/share/spack/setup-env.sh

export MYCUDA=12.8.1
export MYCUDA=13.0.0
#export MYCUDA=13.1.1
#export MYCUDA=13.2.1
#export MYCUDA=13.3.1

#module load gcc/12.2.1
module load gcc/14.0.1
module load cuda/${MYCUDA}

export PAPI_CUDA_ROOT=/packages/cuda/${MYCUDA}

export PAPI_DIR=/home/users/dbarry/apps/papi-hopper-tmp
export PAPI=${PAPI_DIR}
export LD_LIBRARY_PATH=${PAPI_DIR}/lib:${LD_LIBRARY_PATH}
export LD_LIBRARY_PATH=${PAPI_DIR}/lib:${LD_LIBRARY_PATH}
export PATH=${PAPI_DIR}/bin:${PATH}

export PAPI_DEBUG=ALL
