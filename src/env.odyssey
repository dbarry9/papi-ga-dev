## Main variables.
export PAPI=/home/users/dbarry/apps/papi-odyssey-master-rocm-${MYROCM}
export PAPI_DIR=${PAPI}
export LD_LIBRARY_PATH=${PAPI_DIR}/lib:${LD_LIBRARY_PATH}
